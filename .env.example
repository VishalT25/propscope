# Copy to .env (never commit .env). Live data stays OFF unless LIVE_DATA=true.
# --- Required to self-host with Docker Compose (bin/self-host generates these for you) ---
SECRET_KEY_BASE=
PROPSCOPE_DATABASE_PASSWORD=

# --- Data. Live calls only happen when LIVE_DATA=true. You supply your own keys and follow each provider's terms. ---
LIVE_DATA=false
SPORTSGAMEODDS_API_KEY=
BALLDONTLIE_API_KEY=
PROPLINE_API_KEY=

# Optional model service (see model_service/README.md). Leave blank to run without it.
MODEL_SERVICE_URL=
# Shared secret between Rails and the model service (recommended when the service is reachable from the internet).
MODEL_API_KEY=

# Self-hosted copies are single-user (no sign-in). Set to false to enable accounts on a shared deployment.
SINGLE_USER=true

# Extra hourly odds snapshots before each tip (0 to 6). Each costs one SportsGameOdds event per game; see docs/operations.md.
ODDS_EXTRA_HOURS=3
# Ask SportsGameOdds for alternate lines too (no extra cost: billing is per event).
INCLUDE_ALT_LINES=true

# Optional: shown in Settings, About when the app runs from a Docker image (which has no .git). See docs/self-hosting.md.
# GIT_SHA=
# GIT_BRANCH=
# GIT_COMMITTED_AT=
# BUILD_TIME=
