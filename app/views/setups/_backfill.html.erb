<%# locals: run, estimates %>
<section class="mt-6 max-w-2xl">
  <%= turbo_frame_tag "backfill_progress" do %>
    <%= render "setups/progress", run: run %>
  <% end %>

  <% unless run&.active? || run&.done? && !Setup.intent_live? %>
    <%= form_with url: backfill_setup_path, method: :post, class: "mt-6" do %>
      <fieldset>
        <legend class="font-bold">How much history?</legend>
        <p class="mt-1 text-sm text-muted">Hit rates use recent games, this season and last season, and games against the same opponent, so two seasons is best.</p>
        <div class="mt-3 space-y-2">
          <% estimates.each do |seasons, e| %>
            <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-line p-3 has-[:checked]:border-accent">
              <input type="radio" name="seasons" value="<%= seasons %>" <%= "checked" if seasons == 2 %> class="radio radio-sm mt-0.5">
              <span class="text-sm"><b><%= pluralize(seasons, "season") %></b><%= " (recommended)" if seasons == 2 %><br>
                <span class="text-muted">about <%= e.minutes %> minutes, roughly <%= number_with_delimiter(e.requests) %> requests to BallDontLie</span></span>
            </label>
          <% end %>
        </div>
      </fieldset>
      <p class="mt-3 text-xs text-muted">It also fetches today's odds, which uses a few events of your SportsGameOdds allowance. If it stops, nothing is lost: starting it again carries on where it left off.</p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button type="submit" class="btn btn-primary btn-sm" data-turbo-submits-with="Starting…"><%= run && !run.done? ? "Start again" : "Load my history" %></button>
        <%= link_to "Change keys", setup_path(step: "keys"), class: "text-sm font-semibold text-muted hover:text-fg" %>
      </div>
    <% end %>
  <% end %>
</section>
