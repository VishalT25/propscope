<% g = card.game %>
<article class="card p-4">
  <header class="flex items-center justify-between text-sm text-muted">
    <span class="font-semibold text-fg"><%= g.away_team.abbreviation %> @ <%= g.home_team.abbreviation %></span>
    <span><%= local_time(g.starts_at) %></span>
  </header>

  <% [ [ g.away_team, "away", card.away_record ], [ g.home_team, "home", card.home_record ] ].each do |team, side, record| %>
    <section class="mt-3 border-t border-line pt-3 first-of-type:border-0 first-of-type:pt-0">
      <div class="flex items-center gap-2.5">
        <%= team_badge(team, size: :md) %>
        <div class="min-w-0"><div class="truncate font-semibold"><%= team.name %></div><div class="text-xs text-muted"><%= record %></div></div>
      </div>
      <div class="mt-2 grid grid-cols-3 gap-x-4">
        <%= render "shared/line_cell", cell: card.lines.moneyline[side], strip: card.strips[[ "moneyline", side ]], label: "ML", show_line: false %>
        <%= render "shared/line_cell", cell: card.lines.spread[side], strip: card.strips[[ "spread", side ]], label: "" %>
        <%= render "shared/line_cell", cell: card.lines.total[side == "away" ? "over" : "under"], strip: card.strips[[ "total", side == "away" ? "over" : "under" ]], label: side == "away" ? "O" : "U" %>
      </div>
    </section>
  <% end %>

  <footer class="mt-3 flex items-center justify-between border-t border-line pt-3 text-sm">
    <span class="text-muted">Strips: share of recent games that cleared today's line</span>
    <%= link_to "Match details →", league_game_path(current_league, g), class: "font-semibold text-accent hover:underline" %>
  </footer>
</article>
