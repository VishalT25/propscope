<dialog id="picks_slip" class="modal modal-bottom sm:modal-middle" aria-label="My slip">
  <div class="modal-box max-w-xl bg-surface">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold">My slip</h2>
      <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost" aria-label="Close"><%= icon :close, css: "size-4" %></button></form>
    </div>
    <%= render "picks/slip_frame", slip: slip %>
  </div>
  <form method="dialog" class="modal-backdrop"><button aria-label="Close">close</button></form>
</dialog>
