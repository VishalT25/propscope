<% content_for :title, "New password" %>
<div class="card mx-auto mt-10 w-full max-w-md p-6">
  <h1 class="text-2xl font-extrabold tracking-tight">Update your password</h1>
  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-5 space-y-3" do |form| %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "New password", maxlength: 72, class: "field" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72, class: "field" %>
    <%= form.submit "Save", class: "btn w-full cursor-pointer" %>
  <% end %>
</div>
