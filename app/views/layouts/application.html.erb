<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · #{app_name}" : app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= app_name %>">
    <meta name="color-scheme" content="dark light">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script>
      try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh antialiased">
    <%# One sheet controller wraps the header chip and the panel. The panel must NOT live inside the header:
        its backdrop-blur would become the containing block for the panel's position: fixed. %>
    <div data-controller="sheet">
      <%= render "shared/header" %>
      <%= render "books/panel" %>
    </div>
    <%= render "shared/flash" %>
    <main class="mx-auto w-full max-w-screen-2xl px-4 pb-24 pt-4">
      <%= yield %>
    </main>
  </body>
</html>
