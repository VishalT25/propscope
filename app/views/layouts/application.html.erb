<!DOCTYPE html>
<html lang="en" data-theme="propscope-dark">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · #{app_name}" : app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= app_name %>">
    <meta name="color-scheme" content="dark light">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script>
      try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = "propscope-" + t; } catch (e) {}
    </script>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Hanken+Grotesk:wght@400..800&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[70] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-on-accent">Skip to content</a>
    <%# One sheet controller wraps the header chip and the panel. The panel must NOT live inside the header:
        its backdrop-blur would become the containing block for the panel's position: fixed. %>
    <div data-controller="sheet">
      <%= render "shared/header" %>
      <%= render "books/panel" %>
    </div>
    <%= render "picks/slip", slip: slip %>
    <div id="toast" class="pointer-events-none fixed bottom-4 left-1/2 z-[60] -translate-x-1/2"></div>
    <%= render "shared/flash" %>
    <main id="main" tabindex="-1" class="focus:outline-none mx-auto w-full max-w-screen-2xl px-4 pb-24 pt-4">
      <%= yield %>
    </main>
  </body>
</html>
