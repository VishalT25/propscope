<section class="card p-4">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="font-bold">Vs <%= d.opponent.name %> · <%= d.history_position == "all" ? "all positions" : "#{d.history_position} players" %></h2>
    <div class="flex gap-1.5" role="group" aria-label="Position">
      <% %w[all G F C].each do |pos| %>
        <%= link_to (pos == "all" ? "All" : pos), detail_path(d, pos: pos), class: "chip #{'chip-active' if pos == d.history_position}" %>
      <% end %>
    </div>
  </div>
  <% if d.history.empty? %>
    <p class="mt-3 rounded-xl bg-surface-2 py-8 text-center text-sm text-muted">No games by this position against <%= d.opponent.name %> yet.</p>
  <% else %>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-left text-xs uppercase tracking-wide text-muted"><tr><th class="py-1.5">Player</th><th class="text-right">Result</th><th class="text-right" title="The line that game closed at. A star means we have no closing line, so the current line is used.">Line</th><th class="w-10 text-center"></th></tr></thead>
        <tbody class="divide-y divide-line">
          <% d.history.each do |h| %>
            <tr>
              <td class="py-2"><span class="inline-flex items-center gap-2"><%= player_avatar(h.player, size: :sm, badge: false) %><span><span class="font-medium"><%= h.player.full_name %></span> <span class="block text-xs text-muted"><%= h.date.strftime("%b %-d") %></span></span></span></td>
              <td class="text-right font-bold tabular-nums"><%= h.value %></td>
              <td class="text-right tabular-nums text-muted"><%= number_with_precision(h.line, precision: 1) %><%= "*" if h.line_kind == :current %></td>
              <td class="text-center"><% if h.outcome.nil? %><span class="text-push" title="Push">–</span><% elsif h.outcome == (d.side == "over") %><span class="text-hit" title="Cleared" aria-label="Hit"><%= icon :check, css: "inline size-4" %></span><% else %><span class="text-miss" title="Missed" aria-label="Miss"><%= icon :close, css: "inline size-4" %></span><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="mt-2 text-xs text-muted">* current line used because no closing line was saved for that game. Tick = a <%= d.side %> bet would have won.</p>
  <% end %>
</section>
