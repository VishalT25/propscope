<tr class="hover:bg-surface-2/60">
  <td class="px-3 py-2.5">
    <div class="flex items-center gap-2.5">
      <%= player_avatar(row.player) %>
      <div>
        <%= link_to row.player.full_name, league_prop_path(current_league, row.market, row.side), class: "font-semibold hover:text-accent", data: { turbo_frame: "_top" } %>
        <div class="text-xs text-muted" title="Team and position"><%= row.team.abbreviation %> · <%= row.player.position %></div>
      </div>
    </div>
  </td>
  <td class="px-3 py-2.5 text-xs text-muted">
    <div class="flex items-center gap-1.5"><%= row.home? ? "vs" : "@" %> <%= team_badge(row.opponent, size: :xs) %> <b class="text-fg"><%= row.opponent.abbreviation %></b></div>
    <div><%= local_day(row.game.starts_at) %>, <%= local_time(row.game.starts_at) %></div>
  </td>
  <td class="px-3 py-2.5 font-semibold"><%= link_to pick_title(row), league_prop_path(current_league, row.market, row.side), class: "hover:text-accent", data: { turbo_frame: "_top" } %></td>
  <td class="px-3 py-2.5"><%= render "shared/price_chip", american: row.price.american_odds, bookmaker: row.price.bookmaker, book_name: "#{row.price.bookmaker.name} (#{pluralize(row.price.books_count, 'book')} offering this line)" %></td>
  <td class="px-3 py-2.5 text-right tabular-nums text-muted" title="Implied probability of the best price"><%= number_with_precision(row.implied * 100, precision: 1) %>%</td>
  <td class="px-3 py-2.5 text-center">
    <% if row.opp_rank %>
      <span class="inline-flex min-w-9 justify-center rounded-full px-2 py-0.5 text-xs font-bold tabular-nums <%= PropsHelper::TIER_STYLES[row.tier] %>" title="<%= tier_tooltip(row) %>"><%= row.opp_rank.rank %></span>
    <% else %><span class="text-muted" title="No defence data yet">–</span><% end %>
  </td>
  <% if show_model %>
    <td class="p-0.5 text-center">
      <% if row.prediction %><div class="rounded-lg px-1 py-2 font-bold tabular-nums <%= hit_rate_text_class(model_pct(row.prediction), 100) %>" style="<%= hit_rate_cell_style(model_pct(row.prediction), 100) %>" title="<%= model_tooltip(row) %>"><%= percent_label(model_pct(row.prediction)) %></div>
      <% else %><span class="text-muted" title="No model prediction for this prop">–</span><% end %>
    </td>
  <% end %>
  <% PropsHelper::HIT_COLUMNS.each do |key, label, _| %>
    <% rate, n = row.rate(key), row.sample(key) %>
    <td class="p-0.5 text-center">
      <div class="rounded-lg px-1 py-2 font-bold tabular-nums <%= hit_rate_text_class(rate, n) %>" style="<%= hit_rate_cell_style(rate, n) %>" title="<%= hit_tooltip(label, rate, n) %>"><%= percent_label(rate, n) %></div>
    </td>
  <% end %>
  <td class="px-2 text-right"><%= render "props/add_pick", market: row.market, side: row.side %></td>
</tr>
