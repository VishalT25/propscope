<%# No prop has odds right now, and no filter is the reason. One sentence of what to expect, the one action, and the detail only if wanted. %>
<% next_game = Game.where(starts_at: Time.current..).minimum(:starts_at) %>
<% coming = Game.where(starts_at: Time.current..36.hours.from_now).count %>
<% budget = BudgetGuard.report("sports_game_odds") %>
<div class="card mt-3 px-6 py-12">
  <div class="mx-auto max-w-md text-center">
    <h2 class="text-lg font-bold">No props to show yet</h2>

    <% if Setup.live? %>
      <p class="mt-2 text-sm text-muted text-pretty">Sportsbooks usually post player props on the day of the game.</p>
      <% if next_game %><p class="mt-1 text-sm text-fg">Next game: <b><%= local_day(next_game) %>, <%= local_time(next_game) %></b></p><% end %>

      <% if current_user&.admin? %>
        <%= button_to "Refresh odds now", refresh_odds_setup_path, method: :post, class: "btn btn-primary btn-sm mt-5", form: { class: "contents", data: { turbo: false } } %>
        <p class="mt-2 text-xs text-muted">
          Uses roughly one SportsGameOdds event per game coming up<%= " (#{coming} now)" if coming.positive? %>.
          <%= "#{number_with_delimiter(budget.used)} of #{number_with_delimiter(budget.limit)} used this month." if budget.limit %>
        </p>
      <% end %>

      <details class="mt-6 text-left text-sm">
        <summary class="cursor-pointer text-center font-medium text-muted hover:text-fg">How odds arrive</summary>
        <p class="mt-2 text-muted text-pretty">
          With the Docker install a background worker fetches them for you: 10 AM and 3 PM Eastern, then every few minutes close to tip-off.
          Started with <code class="rounded bg-surface-2 px-1">bin/rails server</code>, there is no worker, so odds are only fetched when an admin refreshes them<%= current_user&.admin? ? " (the button above)" : "" %>.
        </p>
      </details>
    <% else %>
      <p class="mt-2 text-sm text-muted text-pretty">Sample data is made up, and it is re-dated automatically every morning and whenever you open this page after its slate has passed.</p>
      <% if current_user&.admin? %>
        <%= button_to "Refresh sample data", choose_setup_path(mode: "sample", back: league_props_path(current_league)), method: :post, class: "btn btn-primary btn-sm mt-5", form: { class: "contents", data: { turbo: false } } %>
      <% end %>
    <% end %>
  </div>
</div>
