<% pts = d.movement.points %>
<section class="card p-4" data-controller="chart" data-chart-config-value="<%= movement_chart_config(d.movement).to_json %>">
  <h2 class="text-lg font-bold">Consensus line movement</h2>
  <div class="mt-3 grid grid-cols-2 gap-1 rounded-xl border border-line bg-surface-2 p-1 text-center text-sm font-bold" role="group" aria-label="Side">
    <% %w[over under].each do |side| %>
      <%= link_to side.capitalize, detail_path(d, move: side), class: "rounded-lg py-1.5 #{side == d.movement_side ? 'bg-fg text-canvas' : 'text-muted hover:text-fg'}" %>
    <% end %>
  </div>
  <% if pts.any? %>
    <div class="mt-3 inline-flex items-center gap-3 rounded-xl border border-line px-3 py-2"><span class="size-2 rounded-full bg-accent"></span>
      <span><span class="block text-xl font-extrabold tabular-nums"><%= number_with_precision(pts.last.line, precision: 1) %></span><span class="text-xs text-muted">Line</span></span></div>
  <% end %>
  <% if pts.size < 2 %>
    <p class="mt-3 rounded-xl bg-surface-2 py-8 text-center text-sm text-muted"><%= pts.empty? ? "No snapshots yet." : "Only one snapshot so far (#{number_with_precision(pts.first.line, precision: 1)}). Movement appears as we collect more." %></p>
  <% else %>
    <div class="relative mt-3 h-44" data-testid="movement-chart"><canvas data-chart-target="canvas" role="img" aria-label="Consensus line over time"></canvas></div>
  <% end %>
  <% if pts.any? %>
    <div class="mt-3 max-h-72 overflow-y-auto overflow-hidden rounded-xl border border-line">
      <table class="w-full text-sm">
        <thead class="sticky top-0 bg-surface-2 text-left text-xs text-muted"><tr><th class="px-3 py-2">Updated</th><th class="px-3 text-right">Best</th><th class="px-3 text-right">Line</th></tr></thead>
        <tbody class="divide-y divide-line">
          <% pts.reverse.each do |p| %>
            <tr><td class="px-3 py-2 text-xs"><span class="font-semibold"><%= local_time(p.at) %></span> <span class="block text-muted"><%= local_day(p.at) %></span></td>
              <td class="px-3 text-right tabular-nums"><%= format_price(p.best_odds) %> <%= change_arrow(p.odds_change) %></td>
              <td class="px-3 text-right font-bold tabular-nums"><%= number_with_precision(p.line, precision: 1) %>
                <% if p.line_delta && !p.line_delta.zero? %><span class="text-xs <%= p.line_delta.positive? ? 'text-hit' : 'text-miss' %>"><%= p.line_delta.positive? ? "▲" : "▼" %><%= number_with_precision(p.line_delta.abs, precision: 1, strip_insignificant_zeros: true) %></span><% else %><span class="text-muted">–</span><% end %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
