<li class="card reveal p-3.5" style="--i: <%= local_assigns[:i] || 0 %>">
  <div class="flex items-start justify-between gap-3">
    <%= player_avatar(row.player) %>
    <div class="min-w-0 flex-1">
      <div class="truncate font-bold"><%= link_to row.player.full_name, league_prop_path(current_league, row.market, row.side), data: { turbo_frame: "_top" } %> <span class="text-xs font-medium text-muted"><%= row.team.abbreviation %> · <%= row.player.position %></span></div>
      <div class="mt-0.5 text-xs text-muted"><%= row.home? ? "vs" : "@" %> <b class="text-fg"><%= row.opponent.abbreviation %></b> · <%= local_day(row.game.starts_at) %>, <%= local_time(row.game.starts_at) %></div>
      <div class="mt-1.5 font-semibold"><%= pick_title(row) %></div>
    </div>
    <div class="shrink-0 text-right">
      <%= render "shared/price_chip", american: row.price.american_odds, bookmaker: row.price.bookmaker, book_name: row.price.bookmaker.name %>
      <div class="mt-1 text-xs tabular-nums text-muted" title="Implied probability of the best price">IP <%= number_with_precision(row.implied * 100, precision: 1) %>%</div>
      <div class="mt-1.5"><%= render "props/add_pick", market: row.market, side: row.side %></div>
    </div>
  </div>
  <div class="no-scrollbar -mx-1 mt-3 flex gap-1 overflow-x-auto px-1 text-center">
    <div class="w-14 shrink-0 rounded-lg bg-surface-2 px-1 py-1.5" title="<%= tier_tooltip(row) %>">
      <div class="text-[10px] font-semibold text-muted">OPP</div>
      <div class="text-sm font-bold tabular-nums <%= row.tier ? { 'favorable' => 'text-hit', 'unfavorable' => 'text-miss' }.fetch(row.tier, 'text-muted') : 'text-muted' %>"><%= row.opp_rank&.rank || "–" %></div>
    </div>
    <% if row.prediction %>
      <div class="w-14 shrink-0 rounded-lg px-1 py-1.5" style="<%= hit_rate_cell_style(model_pct(row.prediction), 100) %>" title="<%= model_tooltip(row) %>">
        <div class="text-[10px] font-semibold text-muted">MODEL</div>
        <div class="text-sm font-bold tabular-nums <%= hit_rate_text_class(model_pct(row.prediction), 100) %>"><%= percent_label(model_pct(row.prediction)) %></div>
      </div>
    <% end %>
    <% PropsHelper::HIT_COLUMNS.each do |key, label, _| %>
      <% rate, n = row.rate(key), row.sample(key) %>
      <div class="w-14 shrink-0 rounded-lg px-1 py-1.5" style="<%= hit_rate_cell_style(rate, n) %>" title="<%= hit_tooltip(label, rate, n) %>">
        <div class="text-[10px] font-semibold text-muted"><%= label.upcase %></div>
        <div class="text-sm font-bold tabular-nums <%= hit_rate_text_class(rate, n) %>"><%= percent_label(rate, n) %><% if small_sample?(n) %><sup class="ml-0.5 text-[9px] font-semibold opacity-70" title="Based on <%= n %> <%= 'game'.pluralize(n) %>"><%= n %>g</sup><% end %></div>
      </div>
    <% end %>
  </div>
</li>
