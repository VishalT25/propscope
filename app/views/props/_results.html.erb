<div class="mt-4 flex flex-wrap items-center justify-between gap-2 text-sm text-muted">
  <%# The toolbar sits outside this frame; it reads these when the frame loads (see filters_controller). %>
  <span hidden data-total="<%= result.total %>" data-count-label="<%= number_with_delimiter(result.total) %> <%= "prop".pluralize(result.total) %>" data-apply-label="<%= props_count_label(result.total) %>"></span>
  <p><%= updated_ago(result.updated_at).capitalize %><% if result.prices_at %> · prices <%= time_ago_in_words(result.prices_at) %> ago<% end %></p>
  <details class="relative">
    <summary class="-my-1.5 cursor-pointer select-none py-1.5 font-medium hover:text-fg">Legend</summary>
    <div class="absolute right-0 z-20 mt-2 w-80 space-y-1.5 rounded-xl border border-line bg-surface p-3 text-xs shadow-xl">
      <p><b class="text-fg">Best price</b>: highest price across your enabled books, with the book's code. <b class="text-fg">Only EV+</b> keeps the props whose best price beats the market's fair price by 1% or more, the same maths as the EV+ page, and shows that edge under the price.</p>
      <p><b class="text-fg">IP</b>: implied probability of that price (it includes the book's margin).</p>
      <p><b class="text-fg">Opp</b>: the opponent's overall rank for this stat, all positions (1 = toughest defence; position splits are on the prop page). <span class="text-hit">Favorable</span> / <span class="text-miss">Unfavorable</span> are from this bet's side.</p>
      <p><b class="text-fg">L5 / L10 / L20</b>: share of the last N games that cleared the line. <b class="text-fg">H2H</b>: vs this opponent, this and last season. <b class="text-fg">Prev</b>: last season.</p>
      <p><span class="text-hit font-bold">Green</span> hit more than 60%, <span class="text-push font-bold">amber</span> 41 to 60%, <span class="text-miss font-bold">red</span> 40% or less. A small superscript (like <sup>2g</sup>) means the rate rests on fewer than 5 games; <span class="font-bold">n/a</span> means no games. DNPs and pushes are excluded.</p>
    </div>
  </details>
</div>

<% show_model = result.rows.any?(&:prediction) %>
<% if result.rows.empty? %>
  <% if filters.active_count.positive? %>
    <div class="card mt-3 grid place-items-center px-6 py-14 text-center">
      <h2 class="text-lg font-bold">No props match</h2>
      <p class="mt-1 max-w-md text-sm text-muted">Loosen a filter or <%= link_to "reset them all", league_props_path(current_league), class: "text-accent underline", data: { turbo: false } %>.</p>
    </div>
  <% else %>
    <%= render "props/no_odds" %>
  <% end %>
<% else %>
  <div class="card mt-3 hidden overflow-x-auto md:block">
    <table class="w-full min-w-[56rem] text-sm">
      <thead class="border-b border-line text-left text-xs text-muted">
        <tr>
          <th class="px-3 py-2.5">Player</th>
          <th class="px-3 py-2.5">Matchup</th>
          <th class="p-0"><%= link_to "Pick#{sort_arrow(filters, 'line')}", league_props_path(current_league, sort_link_params(filters, "line")), class: "sort-link block px-3 py-2.5", title: "Sort by line" %></th>
          <th class="p-0"><%= link_to "Best price#{sort_arrow(filters, 'best_odds')}", league_props_path(current_league, sort_link_params(filters, "best_odds")), class: "sort-link block px-3 py-2.5", title: "Sort by best price" %></th>
          <th class="p-0 text-right"><%= link_to "IP#{sort_arrow(filters, 'ip')}", league_props_path(current_league, sort_link_params(filters, "ip")), class: "sort-link block px-3 py-2.5", title: "Implied probability of the best price" %></th>
          <th class="p-0 text-center"><%= link_to "Opp#{sort_arrow(filters, 'opp_rank')}", league_props_path(current_league, sort_link_params(filters, "opp_rank")), class: "sort-link block px-3 py-2.5", title: "Opponent rank vs this position (1 = toughest)" %></th>
          <% if show_model %><th class="p-0 text-center"><%= link_to "Model#{sort_arrow(filters, 'model')}", league_props_path(current_league, sort_link_params(filters, "model")), class: "sort-link block px-1 py-2.5", title: "Model: chance this side wins, from the optional model service. Click to sort." %></th><% end %>
          <% PropsHelper::HIT_COLUMNS.each do |key, label, tip| %>
            <th class="p-0 text-center"><%= link_to "#{label}#{sort_arrow(filters, key)}", league_props_path(current_league, sort_link_params(filters, key)), class: "sort-link block px-1 py-2.5", title: "#{tip}. Click to sort." %></th>
          <% end %>
          <th class="w-12"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% result.rows.each_with_index do |row, i| %>
          <%= render "props/row", row: row, show_model: show_model, i: i %>
        <% end %>
      </tbody>
    </table>
  </div>

  <ul class="mt-3 space-y-3 md:hidden">
    <% result.rows.each_with_index do |row, i| %>
      <%= render "props/card", row: row, i: i %>
    <% end %>
  </ul>

  <% if result.pages > 1 %>
    <nav class="mt-4 flex items-center justify-center gap-3 text-sm" aria-label="Pages">
      <% if result.page > 1 %><%= link_to "← Previous", league_props_path(current_league, filters.to_query(page: result.page - 1)), class: "chip" %><% end %>
      <span class="text-muted">Page <%= result.page %> of <%= result.pages %></span>
      <% if result.page < result.pages %><%= link_to "Next →", league_props_path(current_league, filters.to_query(page: result.page + 1)), class: "chip" %><% end %>
    </nav>
  <% end %>
<% end %>
