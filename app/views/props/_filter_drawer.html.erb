<%# The side panel: the books filter (everything else is a toolbar dropdown), and saved filters. Its fields belong to #filters_form
    through the form attribute, so they apply live like the rest. The Saved tab has forms of its own, which is why this is not inside that form. %>
<div data-sheet-target="backdrop" data-action="click->sheet#close" class="fixed inset-0 z-40 bg-canvas/75" hidden></div>
<aside data-sheet-target="panel" role="dialog" aria-label="Filters" hidden
       class="fixed inset-x-0 bottom-0 z-50 flex max-h-[88dvh] flex-col rounded-t-2xl border border-line bg-surface shadow-2xl md:inset-y-0 md:left-auto md:right-0 md:max-h-none md:w-[26rem] md:rounded-none md:rounded-l-2xl">
  <div class="flex items-center justify-between border-b border-line px-4 py-3">
    <div class="flex gap-1.5">
      <button type="button" class="chip chip-active" data-sheet-target="tab" data-sheet-name-param="filters" data-action="sheet#tab">Filters</button>
      <button type="button" class="chip" data-sheet-target="tab" data-sheet-name-param="templates" data-action="sheet#tab">Saved</button>
    </div>
    <button type="button" class="rounded-lg p-2 hover:bg-surface-2" aria-label="Close" data-action="sheet#close"><%= icon :close, css: "size-4" %></button>
  </div>

  <div data-sheet-target="pane" data-pane="filters" class="flex min-h-0 flex-1 flex-col">
    <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-4 py-4 text-sm">
      <p class="text-xs text-muted">The other filters (propositions, players, games, over / under, Only EV+, odds, hit rate and matchup) are in the bar above. Changes here apply as you make them.</p>

      <fieldset data-filters-target="group" data-group="books" data-controller="checklist">
        <legend class="mb-1.5 flex w-full items-baseline justify-between text-xs font-semibold text-muted">
          <span>Books <span class="font-normal normal-case">(within your enabled books)</span></span>
          <button type="button" class="font-semibold text-accent hover:underline" data-action="checklist#none">Clear</button>
        </legend>
        <div class="grid grid-cols-2 gap-1">
          <% all_bookmakers.each do |b| %>
            <label class="flex items-center gap-2"><%= check_box_tag "book_keys[]", b.key, @filters.book_keys.include?(b.key), id: nil, form: "filters_form", class: "accent-[var(--accent)]", data: { checklist_target: "box", action: "change->checklist#update" } %> <%= book_badge(b) %> <%= b.name %></label>
          <% end %>
        </div>
      </fieldset>
    </div>

    <div class="space-y-2 border-t border-line px-4 py-3">
      <button type="submit" form="filters_form" class="btn btn-primary w-full" data-action="click->sheet#close"><span id="apply_label" data-filters-target="applyLabel"><%= props_count_label(@result.total) %></span></button>
      <%= link_to "Reset", league_props_path(current_league), class: "btn btn-outline w-full", data: { turbo: false } %>
    </div>

    <div class="border-t border-line px-4 py-3"><%= render "props/save_filters" %></div>
  </div>

  <div data-sheet-target="pane" data-pane="templates" class="min-h-0 flex-1 overflow-y-auto px-4 py-4" hidden>
    <div class="mb-4 border-b border-line pb-4"><%= render "props/save_filters" %></div>
    <% saved = current_user ? current_user.saved_filters.where(scope: "props").order(:name) : [] %>
    <% if saved.empty? %>
      <div class="grid place-items-center py-10 text-center text-sm text-muted">
        <p class="font-semibold text-fg">No saved filters yet</p>
        <p class="mt-1 max-w-xs"><%= current_user ? "Set some filters, name them above and press Save." : "Sign in to save filters as reusable templates." %></p>
      </div>
    <% else %>
      <ul class="space-y-2">
        <% saved.each do |filter| %>
          <li class="flex items-center justify-between gap-2 rounded-xl border border-line px-3 py-2.5">
            <%= link_to filter.name, league_props_path(current_league, filter.params.symbolize_keys), class: "font-semibold hover:text-accent", data: { turbo: false } %>
            <%= button_to "Delete", saved_filter_path(filter), method: :delete, class: "text-xs text-muted hover:text-miss", form: { class: "contents" } %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</aside>
