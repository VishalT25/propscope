<%# The filters toolbar. One form: the dropdowns here and the side panel's fields (form="filters_form") all feed it, and any change applies at once. %>
<% count = @filters.active_count %>
<%= form_with url: league_props_path(current_league), method: :get, id: "filters_form",
      data: { turbo_frame: "props_results", turbo_action: "advance", action: "formdata->filters#strip" },
      class: "rounded-2xl border border-line bg-surface p-2.5", "aria-label": "Filters" do %>
  <%= hidden_field_tag :sort, @filters.sort, id: nil %>
  <%= hidden_field_tag :dir, @filters.dir, id: nil %>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-2.5 md:flex-nowrap">
    <div class="no-scrollbar flex min-w-0 flex-1 items-center gap-2 overflow-x-auto py-0.5 md:flex-wrap md:overflow-visible"><%# scrolls sideways on a phone; wraps on a desktop so nothing is hidden %>
      <div class="flex shrink-0">
        <button type="button" class="fbtn fbtn-solid rounded-r-none" data-action="sheet#open" aria-haspopup="dialog">
          <%= icon :sliders, css: "size-[18px]" %>Filters
          <span class="grid min-w-6 place-items-center rounded-full bg-canvas px-1.5 text-xs font-extrabold tabular-nums text-fg" data-filters-target="badge" <%= "hidden" if count.zero? %>><%= count if count.positive? %></span>
        </button>
        <%= link_to league_props_path(current_league), class: "fbtn fbtn-solid -ml-px rounded-l-none px-2.5", "aria-label": "Clear all filters", title: "Clear all filters",
              data: { turbo: false, filters_target: "clear" }, hidden: count.zero? do %><%= icon :close, css: "size-4" %><% end %>
      </div>

      <button type="button" class="fbtn" data-action="sheet#open" data-sheet-tab-param="templates" aria-haspopup="dialog"><%= icon :bookmark, css: "size-[18px]" %>Saved</button>

      <%= render layout: "props/chip_dropdown", locals: { id: "propositions", group: "propositions", label: "Propositions", icon_name: :list, width: "w-64",
                                                          active: @filters.market_types.any?, count: @filters.market_types.size } do %>
        <fieldset data-filters-target="group" data-group="propositions">
          <legend class="sr-only">Propositions</legend>
          <div class="space-y-2">
            <% StatCatalog::ALL.each do |stat| %>
              <label class="flex cursor-pointer items-center gap-2.5"><%= check_box_tag "market_types[]", stat.market_type, @filters.market_types.include?(stat.market_type), id: nil, class: "size-4 accent-[var(--accent)]" %> <%= stat.label %></label>
            <% end %>
          </div>
        </fieldset>
      <% end %>

      <%= render layout: "props/chip_dropdown", locals: { id: "players", group: "q", label: "Players", icon_name: :search, width: "w-72", active: @filters.q.present?, count: 0 } do %>
        <div data-filters-target="group" data-group="q">
          <label class="mb-1.5 block text-xs font-semibold text-muted" for="f_q">Player name</label>
          <%= search_field_tag :q, @filters.q, id: "f_q", placeholder: "Search players", class: "field", autocomplete: "off" %>
          <p class="mt-1.5 text-xs text-muted">Results update as you type.</p>
        </div>
      <% end %>

      <%= render layout: "props/chip_dropdown", locals: { id: "games", group: "games", label: "Games", icon_name: :calendar, width: "w-80",
                                                          active: @filters.game_ids.any?, count: @filters.game_ids.size } do %>
        <fieldset data-filters-target="group" data-group="games">
          <legend class="sr-only">Games</legend>
          <% if @games.empty? %>
            <p class="text-muted">No upcoming games.</p>
          <% else %>
            <div class="max-h-72 space-y-2 overflow-y-auto pr-1">
              <% @games.each do |g| %>
                <label class="flex cursor-pointer items-center gap-2.5"><%= check_box_tag "game_ids[]", g.id, @filters.game_ids.include?(g.id), id: nil, class: "size-4 accent-[var(--accent)]" %>
                  <span><%= g.away_team.abbreviation %> @ <%= g.home_team.abbreviation %> <span class="text-xs text-muted"><%= local_day(g.starts_at) %>, <%= local_time(g.starts_at) %></span></span></label>
              <% end %>
            </div>
          <% end %>
        </fieldset>
      <% end %>

      <%= render layout: "props/chip_dropdown", locals: { id: "side", group: "side", label: "Over / Under", icon_name: :updown, width: "w-64", active: @filters.side.present?, count: 0 } do %>
        <fieldset data-filters-target="group" data-group="side">
          <legend class="sr-only">Over or under</legend>
          <div class="grid grid-cols-3 gap-1 rounded-xl bg-surface-2 p-1 text-center font-semibold">
            <% [ [ "", "Both" ], [ "over", "Over" ], [ "under", "Under" ] ].each do |value, label| %>
              <label class="cursor-pointer rounded-lg px-2 py-1.5 has-[:checked]:bg-accent has-[:checked]:text-on-accent"><%= radio_button_tag :side, value, @filters.side.to_s == value, id: nil, class: "sr-only" %><%= label %></label>
            <% end %>
          </div>
        </fieldset>
      <% end %>

      <label class="fbtn has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-primary" data-filters-target="group chip" data-group="ev" data-active="<%= @filters.ev %>"
             title="Only props whose best price beats the market's fair price by 1% or more (the same maths as the EV+ page)">
        <%= check_box_tag :ev, "1", @filters.ev, id: nil, class: "sr-only" %>
        <%= icon :trend, css: "size-[18px]" %>Only EV+
      </label>

      <%= render layout: "props/chip_dropdown", locals: { id: "odds", group: "odds", label: "Odds", icon_name: :dollar, width: "w-72",
                                                          active: (@filters.odds_min || @filters.odds_max).present?, count: 0 } do %>
        <fieldset data-filters-target="group" data-group="odds">
          <legend class="mb-1.5 text-xs font-semibold text-muted">Best price, American odds <span class="font-normal">(e.g. -200 to +150)</span></legend>
          <div class="grid grid-cols-2 gap-2">
            <%= number_field_tag :odds_min, @filters.odds_min, id: nil, placeholder: "Min", class: "field", "aria-label": "Minimum odds" %>
            <%= number_field_tag :odds_max, @filters.odds_max, id: nil, placeholder: "Max", class: "field", "aria-label": "Maximum odds" %>
          </div>
        </fieldset>
      <% end %>

      <%= render layout: "props/chip_dropdown", locals: { id: "hit", group: "hit", label: "Hit rate", icon_name: :bars, width: "w-72", active: @filters.min_hit_rate.present?, count: 0 } do %>
        <fieldset data-filters-target="group" data-group="hit">
          <legend class="mb-1.5 text-xs font-semibold text-muted">At least this share of games cleared the line</legend>
          <div class="grid grid-cols-2 gap-2">
            <%= number_field_tag :min_hit_rate, @filters.min_hit_rate, id: nil, min: 0, max: 100, placeholder: "e.g. 70 (%)", class: "field", "aria-label": "Minimum hit rate percent" %>
            <%= select_tag :hit_window, options_for_select(PropsHelper::HIT_COLUMNS.map { |k, l, _| [ l, k ] }, @filters.hit_window), id: nil, class: "field", "aria-label": "Hit rate window", data: { ignore: "" } %>
          </div>
          <p class="mt-1.5 text-xs text-muted">Needs at least <%= ApplicationHelper::MIN_SAMPLE %> games in that window (1 for H2H).</p>
        </fieldset>
      <% end %>

      <%= render layout: "props/chip_dropdown", locals: { id: "tier", group: "tier", label: "Opponent matchup", icon_name: :shield, width: "w-64", active: @filters.tier.present?, count: 0 } do %>
        <fieldset data-filters-target="group" data-group="tier">
          <legend class="mb-1.5 text-xs font-semibold text-muted">How the opponent defends this stat, from the bet's side</legend>
          <div class="space-y-2">
            <% [ [ "", "Any" ], %w[favorable Favorable], %w[neutral Neutral], %w[unfavorable Unfavorable] ].each do |value, label| %>
              <label class="flex cursor-pointer items-center gap-2.5"><%= radio_button_tag :tier, value, @filters.tier.to_s == value, id: nil, class: "radio radio-sm" %> <%= label %></label>
            <% end %>
          </div>
        </fieldset>
      <% end %>
    </div>

    <div class="flex shrink-0 items-center gap-4 md:border-l md:border-line md:pl-4">
      <label class="flex cursor-pointer items-center gap-2.5 text-sm font-semibold" data-filters-target="group" data-group="alt">
        <%= check_box_tag :alt, "1", @filters.alt, id: nil, class: "toggle toggle-primary toggle-sm" %>Show alt lines
      </label>
      <p class="text-sm font-semibold tabular-nums" aria-live="polite" data-filters-target="count"><%= number_with_delimiter(@result.total) %> <%= "prop".pluralize(@result.total) %></p>
    </div>
  </div>
<% end %>
