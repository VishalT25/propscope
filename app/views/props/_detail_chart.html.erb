<% s = d.summary %>
<% r = d.rates %>
<section class="card p-4" data-controller="chart" data-chart-config-value="<%= bars_chart_config(d).to_json %>">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="grid grid-cols-6 gap-1 rounded-xl border border-line bg-surface-2 p-1" role="group" aria-label="Time window">
      <% PropsHelper::HIT_COLUMNS.each do |key, _label, tip| %>
        <%= link_to window_pill_label(key, d.game.season), detail_path(d, window: key), class: "rounded-lg px-3 py-1.5 text-center text-sm font-bold #{key == d.window ? 'bg-fg text-canvas' : 'text-muted hover:text-fg'}", title: tip, "aria-current": (key == d.window ? "true" : nil) %>
      <% end %>
    </div>
  </div>

  <h2 class="mt-4 flex items-center gap-2 font-bold"><span class="text-accent-2"><%= icon :bars, css: "size-5" %></span> <%= d.player.full_name %> - <%= StatCatalog.for_market(d.market.market_type).label %></h2>

  <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <dl class="flex gap-6">
      <div title="Games that cleared the current line, out of games decided (pushes and DNPs excluded)">
        <dt class="text-sm font-semibold"><%= window_label(d.window) %> vs current</dt>
        <dd class="text-3xl font-extrabold tabular-nums <%= hit_rate_text_class(s.rate, s.hits + s.misses) %>"><%= percent_label(s.rate) %> <span class="text-sm font-medium text-muted"><%= s.hits %> of <%= s.hits + s.misses %></span></dd>
      </div>
      <div title="Games that cleared the line that game actually closed at (only games where we saved a closing line)">
        <dt class="text-sm font-semibold"><%= window_label(d.window) %> vs <span class="text-accent">close</span></dt>
        <dd class="text-3xl font-extrabold tabular-nums <%= hit_rate_text_class(s.closing_rate, s.closing_n) %>"><%= percent_label(s.closing_rate) %> <% if s.closing_n.positive? %><span class="text-sm font-medium text-muted"><%= s.closing_hits %> of <%= s.closing_n %></span><% end %></dd>
      </div>
    </dl>
    <% if r %>
      <dl class="grid grid-cols-[auto_auto_auto_auto_auto_auto] items-center gap-x-4 gap-y-1 text-sm tabular-nums" aria-label="Hit rate in every window">
        <% [ [ "l5", "L5" ], [ "h2h", "H2H" ], [ "prev_season", d.game.season - 1 ] ].zip([ [ "l20", "L20" ], [ "season", d.game.season ], nil ]).each do |a, b| %>
          <dt class="text-muted"><%= a[1] %></dt><dd class="text-right font-bold <%= hit_rate_text_class(r.public_send(a[0]), r.public_send("#{a[0]}_n")) %>"><%= percent_label(r.public_send(a[0])) %></dd>
          <% if b %><dt class="text-muted"><%= b[1] %></dt><dd class="text-right font-bold <%= hit_rate_text_class(r.public_send(b[0]), r.public_send("#{b[0]}_n")) %>"><%= percent_label(r.public_send(b[0])) %></dd><% else %><dt></dt><dd></dd><% end %>
        <% end %>
      </dl>
    <% end %>
  </div>

  <p class="mt-3 border-t border-line pt-3 text-sm text-muted">
    <b class="text-fg"><%= s.mean ? number_with_precision(s.mean, precision: 1) : "–" %></b> Average <span aria-hidden="true">•</span>
    <b class="text-fg"><%= s.median ? number_with_precision(s.median, precision: 1) : "–" %></b> Median <span aria-hidden="true">•</span>
    <b class="text-fg"><%= s.avg_closing_line ? number_with_precision(s.avg_closing_line, precision: 1) : "–" %></b> Average closing line
  </p>

  <% if d.prediction %>
    <p class="mt-2 text-sm text-muted" title="From the optional model service (version <%= d.prediction.model_version %>). A projection from past form, not a guarantee.">
      <b class="text-fg"><%= number_with_precision(d.prediction.probability * 100, precision: 0) %>%</b> model chance of the <%= d.side %>
      <span aria-hidden="true">•</span> projects <b class="text-fg"><%= number_with_precision(d.prediction.projection, precision: 1) %></b> <%= StatCatalog.for_market(d.market.market_type).short.downcase %></p>
  <% end %>

  <% if d.bars.empty? %>
    <div class="mt-4 grid place-items-center rounded-xl bg-surface-2 py-14 text-center text-sm text-muted">
      <p class="font-semibold text-fg">No games in this window yet</p>
      <p class="mt-1"><%= d.window == "prev_season" ? "No previous-season games are loaded." : "Nothing to chart for #{window_label(d.window)}. Try a wider window." %></p>
    </div>
  <% else %>
    <% if d.bars.size < ApplicationHelper::MIN_SAMPLE %><p class="mt-3 text-xs font-medium text-push">Small sample: only <%= pluralize(d.bars.size, "game") %> in this window.</p><% end %>
    <div class="relative mt-3 h-72" data-testid="bars-chart"><canvas data-chart-target="canvas" role="img" aria-label="<%= "#{detail_pick_title(d)}: hit #{s.hits} of #{s.hits + s.misses} games in #{window_label(d.window)}" %>"></canvas></div>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-2 text-xs text-muted">
      <p class="flex flex-wrap gap-x-4 gap-y-1"><span><span class="inline-block size-2 rounded-sm bg-hit"></span> Hit</span><span><span class="inline-block size-2 rounded-sm bg-miss"></span> Miss</span><span><span class="inline-block size-2 rounded-sm bg-push"></span> Push</span><span>Dashed = current line</span></p>
      <label class="flex cursor-pointer items-center gap-2 font-medium text-fg" title="The line each game actually closed at, so a hit is judged against the line that was available then">
        <input type="checkbox" checked class="accent-[var(--accent)]" data-action="chart#toggleClosing"> Closing lines <span class="rounded bg-ev/15 px-1.5 text-[10px] font-bold uppercase text-ev">new</span></label>
    </div>
    <table class="sr-only"><caption>Game-by-game values for <%= window_label(d.window) %></caption>
      <thead><tr><th>Date</th><th>Game</th><th>Value</th><th>Result</th></tr></thead>
      <tbody><% d.bars.each do |b| %><tr><td><%= b.date %></td><td><%= b.label %></td><td><%= b.value %></td><td><%= b.outcome.nil? ? "push" : (b.outcome ? "hit" : "miss") %></td></tr><% end %></tbody></table>
  <% end %>
</section>
