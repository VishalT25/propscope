<header class="sticky top-0 z-40 border-b border-line bg-canvas/90 backdrop-blur" data-controller="toggle" data-action="keydown.esc->toggle#hide click@window->toggle#clickOutside">
  <div class="mx-auto flex h-14 w-full max-w-screen-2xl items-center gap-3 px-4">
    <button type="button" class="-ml-2 rounded-lg p-2 hover:bg-surface-2" aria-label="Menu" data-action="toggle#toggle" data-toggle-target="button">
      <%= icon :menu %>
    </button>

    <%= link_to root_path, class: "flex items-center gap-2 font-extrabold tracking-tight" do %>
      <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="var(--accent)" stroke-width="2.4"/><circle cx="12" cy="12" r="3.2" fill="var(--accent-2)"/></svg>
      <span class="text-lg"><%= app_name %></span>
    <% end %>

    <div class="ml-auto flex items-center gap-2">
      <%= render "books/chip" %>
      <button type="button" class="relative rounded-lg p-2 text-muted transition-colors duration-150 hover:bg-surface-2 hover:text-fg" aria-label="My picks" title="My picks"
              data-controller="dialog" data-action="dialog#open" data-dialog-id-param="picks_slip">
        <%= icon :ticket %>
        <% if current_user && (n = current_user.picks.size).positive? %><span class="absolute -right-0.5 -top-0.5 grid size-4 place-items-center rounded-full bg-accent text-[10px] font-bold text-on-accent"><%= n %></span><% end %>
      </button>
      <%= render "shared/account_menu" %>
    </div>
  </div>

  <nav class="border-t border-line bg-canvas" data-toggle-target="panel" hidden aria-label="Main">
    <ul class="mx-auto grid max-w-screen-2xl gap-1 p-3 sm:grid-cols-2 lg:grid-cols-5">
      <% league_nav_items.each do |label, path, enabled| %>
        <li>
          <% if enabled %>
            <%= link_to label, path, class: "block rounded-xl px-4 py-3 text-base font-semibold hover:bg-surface-2 #{'bg-surface-2' if current_page?(path)}" %>
          <% else %>
            <span class="flex items-center justify-between rounded-xl px-4 py-3 text-base font-semibold text-muted" title="Coming in a later phase">
              <%= label %> <span class="rounded-full bg-surface-2 px-2 py-0.5 text-xs">Soon</span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
</header>
