<header class="sticky top-0 z-40 border-b border-line bg-canvas/90 backdrop-blur">
  <div class="mx-auto flex min-h-14 w-full max-w-screen-2xl flex-wrap items-center gap-x-3 px-4 md:flex-nowrap md:gap-x-6">
    <%= link_to root_path, class: "flex items-center gap-2 py-2 font-extrabold tracking-tight" do %>
      <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="var(--accent)" stroke-width="2.4"/><circle cx="12" cy="12" r="3.2" fill="var(--accent-2)"/></svg>
      <span class="text-lg"><%= app_name %></span>
    <% end %>

    <%# Inline on desktop. On phones it wraps to its own row under the logo and scrolls sideways: no menu to open. %>
    <nav aria-label="Main" class="no-scrollbar order-last -mx-4 w-[calc(100%+2rem)] overflow-x-auto border-t border-line px-3 py-1.5 md:order-none md:mx-0 md:w-auto md:border-0 md:p-0">
      <ul class="flex items-center gap-1">
        <% league_nav_items.each do |label, path| %>
          <% active = nav_active?(path) %>
          <li class="shrink-0">
            <%= link_to label, path, "aria-current": (active ? "page" : nil),
                  class: "block rounded-lg px-3 py-1.5 text-sm font-semibold transition-colors duration-150 #{active ? 'bg-surface-2 text-fg' : 'text-muted hover:bg-surface-2 hover:text-fg'}" %>
          </li>
        <% end %>
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <%= render "books/chip" %>
      <button type="button" class="relative rounded-lg p-2 text-muted transition-colors duration-150 hover:bg-surface-2 hover:text-fg" aria-label="My picks" title="My picks"
              data-controller="dialog" data-action="dialog#open" data-dialog-id-param="picks_slip">
        <%= icon :ticket %>
        <span id="picks_count"><%= render "picks/count", count: current_user ? current_user.picks.size : 0 %></span>
      </button>
      <%= render "shared/account_menu" %>
    </div>
  </div>
</header>
