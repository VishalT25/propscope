<%# locals: title:, body:, phase: %>
<div class="card mt-4 grid place-items-center px-6 py-16 text-center">
  <div class="mb-3 grid size-12 place-items-center rounded-2xl bg-surface-2 text-accent"><%= icon :bars, css: "size-6" %></div>
  <h2 class="text-lg font-bold"><%= title %></h2>
  <p class="mt-1 max-w-md text-sm text-muted"><%= body %></p>
  <span class="mt-4 rounded-full bg-surface-2 px-3 py-1 text-xs font-semibold text-muted">Planned: <%= phase %></span>
</div>
