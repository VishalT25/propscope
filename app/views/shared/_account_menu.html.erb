<div class="relative" data-controller="toggle" data-action="keydown.esc->toggle#hide click@window->toggle#clickOutside">
  <button type="button" class="grid size-9 place-items-center rounded-full border border-line bg-surface-2 text-sm font-bold hover:border-accent" aria-label="Account" data-action="toggle#toggle" data-toggle-target="button">
    <%= current_user ? current_user.initial : icon(:user, css: "size-4") %>
  </button>
  <div class="absolute right-0 mt-2 w-72 rounded-2xl border border-line bg-surface p-3 shadow-xl" data-toggle-target="panel" hidden>
    <% if current_user %>
      <p class="truncate px-2 pb-2 text-sm text-muted"><%= current_user.email_address %></p>
    <% end %>

    <p class="px-2 pb-1 pt-1 text-xs font-semibold uppercase tracking-wide text-muted">Odds format</p>
    <div class="grid grid-cols-2 gap-1 rounded-xl bg-surface-2 p-1" role="group" aria-label="Odds format">
      <% { "american" => "American", "decimal" => "Decimal" }.each do |value, label| %>
        <%= button_to label, preferences_path(odds_format: value), method: :patch,
              class: "w-full rounded-lg px-3 py-1.5 text-sm font-semibold #{value == odds_format ? 'bg-accent text-white' : 'text-muted hover:text-fg'}",
              form: { class: "contents" }, "aria-pressed": value == odds_format %>
      <% end %>
    </div>

    <div data-controller="theme" class="mt-3">
      <p class="px-2 pb-1 text-xs font-semibold uppercase tracking-wide text-muted">Appearance</p>
      <div class="grid grid-cols-2 gap-1 rounded-xl bg-surface-2 p-1">
        <button type="button" data-action="theme#dark" data-theme-target="dark" class="flex items-center justify-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold"><%= icon :moon, css: "size-4" %> Dark</button>
        <button type="button" data-action="theme#light" data-theme-target="light" class="flex items-center justify-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold"><%= icon :sun, css: "size-4" %> Light</button>
      </div>
    </div>

    <div class="mt-3 border-t border-line pt-2 text-sm font-medium">
      <% if current_user %>
        <% if current_user.admin? %><p class="px-2 py-2 text-muted">Admin (coming soon)</p><% end %>
        <%= button_to "Log out", session_path, method: :delete, class: "w-full rounded-lg px-2 py-2 text-left hover:bg-surface-2", form: { class: "contents" } %>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: "block rounded-lg px-2 py-2 hover:bg-surface-2" %>
        <%= link_to "Create account", new_registration_path, class: "block rounded-lg px-2 py-2 hover:bg-surface-2" %>
      <% end %>
    </div>
  </div>
</div>
