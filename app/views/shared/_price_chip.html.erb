<%# locals: american:, book: nil (short code), book_name: nil, bookmaker: nil (record, for a tinted badge) %>
<span class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface-2 px-2.5 py-1.5 text-sm font-bold tabular-nums">
  <%= format_price(american) %>
  <% if local_assigns[:bookmaker] %>
    <span class="rounded-md px-1.5 py-0.5 text-2xs font-extrabold uppercase tracking-wide" style="<%= tint_style(bookmaker.key) %>" title="<%= local_assigns[:book_name] || bookmaker.name %>"><%= bookmaker.code %></span>
  <% elsif local_assigns[:book] %>
    <span class="rounded-md bg-surface px-1.5 py-0.5 text-2xs font-extrabold uppercase tracking-wide text-muted" title="<%= local_assigns[:book_name] || book %>"><%= book %></span>
  <% end %>
</span>
