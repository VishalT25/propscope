#!/usr/bin/env bash
# One command to run your own copy:  bin/self-host
#                                    bin/self-host --model     (also start the optional model service)
# Then open the app: its setup page lets you use sample data, or enter your own API keys and load your history.
set -euo pipefail
cd "$(dirname "$0")/.."

command -v docker >/dev/null || { echo "Docker is required: https://docs.docker.com/get-docker/"; exit 1; }

if [ ! -f .env ]; then
  cp .env.example .env
  echo "Created .env"
fi
set_var() { # set_var NAME VALUE: fill NAME if it is blank, add it if the line is missing, never overwrite a value you set
  if grep -qE "^$1=$" .env; then sed -i.bak "s|^$1=$|$1=$2|" .env && rm -f .env.bak
  elif ! grep -qE "^$1=" .env; then printf '\n%s=%s\n' "$1" "$2" >> .env; fi
}
set_var SECRET_KEY_BASE "$(openssl rand -hex 64)"
set_var PROPSCOPE_DATABASE_PASSWORD "$(openssl rand -hex 16)"

profiles=()
for arg in "$@"; do
  case "$arg" in
    --model)
      profiles=(--profile model)
      set_var MODEL_SERVICE_URL "http://model:8000"   # the web container reaches the model container by name
      set_var MODEL_API_KEY "$(openssl rand -hex 16)" ;;
    --live) echo "Note: --live is no longer needed. Choose \"Use my own data\" on the setup page, or set LIVE_DATA=true in .env." ;;
  esac
done

docker compose "${profiles[@]}" up -d --build
echo "Waiting for the app..."
for _ in $(seq 1 60); do
  curl -fsS "http://localhost:${PORT:-3000}/up" >/dev/null 2>&1 && break
  sleep 2
done

echo "Open http://localhost:${PORT:-3000} and follow the setup page."
echo "It is reachable from this computer only. See docs/self-hosting.md before changing that."
